<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ShaderOutputPath>$(BaseIntermediateOutputPath)Shaders</ShaderOutputPath>
    <ShaderContentIncludePath>Shaders</ShaderContentIncludePath>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>0.4.7</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
    <PackageReference Include="NativeLibraryLoader" Version="1.0.13" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.8" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0" />
    <PackageReference Include="System.Reactive" Version="5.0.0" />
<!--    <PackageReference Include="Veldrid" Version="4.9.0" />-->
<!--    <PackageReference Include="Veldrid.SDL2" Version="4.9.0" />-->
<!--    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />-->
<!--    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />-->
<!--    <PackageReference Include="Veldrid.Utilities" Version="4.9.0" />-->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Shaders\BasicTexture3DShader-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\BasicTexture3DShader-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Phong-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Phong-vertex.glsl" />
    <None Remove="Assets\Shaders\BasicTextureShader-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\BasicTextureShader-fragment.glsl" />
    <None Remove="Assets\Shaders\BasicTextureShader-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\BasicTextureShader-vertex.glsl" />
    <None Remove="Assets\Shaders\Vertex2Color4-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Position3Color3-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Position3Color3-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Vertex2Color4-fragment.glsl" />
    <None Remove="Assets\Shaders\Vertex2Color4-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Vertex2Color4-vertex.glsl" />
    <None Remove="Assets\Shaders\Vertex3Color4-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Vertex3Color4-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Vertex3Color4-fragment.glsl" />
    <None Remove="Assets\Shaders\FullScreenQuadShader-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\FullScreenQuadShader-vertex.glsl" />
    <None Remove="Assets\Shaders\FullScreenQuadShader-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\FullScreenQuadShader-fragment.glsl" />
    <None Remove="Assets\Shaders\Position3TexCoord3Color4-vertex.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Position3TexCoord3Color4-vertex.glsl" />
    <None Remove="Assets\Shaders\Position3TexCoord3Color4-fragment.glsl" />
    <EmbeddedResource Include="Assets\Shaders\Position3TexCoord3Color4-fragment.glsl" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Math" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\modules\veldrid\modules\veldrid-spirv\src\Veldrid.SPIRV\Veldrid.SPIRV.csproj" />
    <ProjectReference Include="..\..\modules\veldrid\src\Veldrid.SDL2\Veldrid.SDL2.csproj" />
    <ProjectReference Include="..\..\modules\veldrid\src\Veldrid.StartupUtilities\Veldrid.StartupUtilities.csproj" />
    <ProjectReference Include="..\..\modules\veldrid\src\Veldrid.Utilities\Veldrid.Utilities.csproj" />
    <ProjectReference Include="..\..\modules\veldrid\src\Veldrid\Veldrid.csproj" />
  </ItemGroup>
  <Target Name="IncludeGeneratedShaderEmbeddedResource" AfterTargets="AssignTargetPaths" Condition="'$(ShaderContentIncludePath)' != ''">
    <ItemGroup>
      <EmbeddedResource Include="@(GeneratedShader)">
        <LogicalName>%(FileName)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>